# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#14111a"

# Main text color
theme[main_fg]="#e8dcc8"

# Title color for boxes
theme[title]="#e8dcc8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d4a84b"

# Background color of selected item in processes box
theme[selected_bg]="#3a3048"

# Foreground color of selected item in processes box
theme[selected_fg]="#d4a84b"

# Color of inactive/disabled text
theme[inactive_fg]="#6b5d6e"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c9bba8"

# Background color of the percentage meters
theme[meter_bg]="#3a3048"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c9bba8"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c47a9a"
theme[mem_box]="#7d9a6e"
theme[net_box]="#c45c5c"
theme[proc_box]="#d4a84b"

# Box divider line and small boxes line color
theme[div_line]="#6b5d6e"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#7d9a6e"
theme[temp_mid]="#e4c36a"
theme[temp_end]="#c45c5c"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#6eb8b0"
theme[cpu_mid]="#5a7aa8"
theme[cpu_end]="#c47a9a"

# Mem/Disk free meter
theme[free_start]="#c47a9a"
theme[free_mid]="#5a7aa8"
theme[free_end]="#6eb8b0"

# Mem/Disk cached meter
theme[cached_start]="#5a7aa8"
theme[cached_mid]="#6eb8b0"
theme[cached_end]="#c47a9a"

# Mem/Disk available meter
theme[available_start]="#e4c36a"
theme[available_mid]="#c45c5c"
theme[available_end]="#c45c5c"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#7d9a6e"
theme[used_mid]="#6eb8b0"
theme[used_end]="#5a7aa8"

# Download graph colors
theme[download_start]="#e4c36a"
theme[download_mid]="#c45c5c"
theme[download_end]="#c45c5c"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#7d9a6e"
theme[upload_mid]="#6eb8b0"
theme[upload_end]="#5a7aa8"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#6eb8b0"
theme[process_mid]="#5a7aa8"
theme[process_end]="#c47a9a"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#14111a"
theme[gradient_color_1]="#221c2a"
theme[gradient_color_2]="#3a3048"
theme[gradient_color_3]="#6b5d6e"
theme[gradient_color_4]="#7a6e78"
theme[gradient_color_5]="#e8dcc8"
theme[gradient_color_6]="#c9bba8"
theme[gradient_color_7]="#f4ead8"
